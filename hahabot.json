{
  "script": "index.js",
  "watch": [
    "events",
    "utils",
    "commands",
    "*.json",
    "index.js"
  ],
  "watch_options": {
    "followSymlinks": false
  },
  "name": "hahabot",
  "log_date_format": "DD-MM HH:mm",
  "error_file": "hahabot_error.log",
  "out_file": "hahabot_out.log",
  "node_args": "--trace-warnings"
}